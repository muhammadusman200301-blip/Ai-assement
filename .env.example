# Copy to .env.local and add your key
OPENAI_API_KEY=
# Primary model, and a cheaper fallback used when the primary fails
PRIMARY_MODEL=gpt-4o
FALLBACK_MODEL=gpt-4o-mini

# Optional: use any OpenAI-compatible provider instead of OpenAI.
# Example for Groq (free tier) — put your Groq key in OPENAI_API_KEY:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# PRIMARY_MODEL=openai/gpt-oss-120b
# FALLBACK_MODEL=openai/gpt-oss-20b
